# Generated from the shared JSON palette. Edit the template, not this file.
[colors.primary]
background = "{{ roles.background }}"
foreground = "{{ roles.foreground }}"

[colors.cursor]
text = "{{ roles.background }}"
cursor = "{{ roles.bright }}"

[colors.selection]
background = "{{ roles.selection }}"
text = "{{ roles.bright }}"

[colors.normal]
black = "{{ palette.graphite }}"
red = "{{ palette.red }}"
green = "{{ palette.green }}"
yellow = "{{ palette.yellow }}"
blue = "{{ palette.blue }}"
magenta = "{{ palette.magenta }}"
cyan = "{{ palette.cyan }}"
white = "{{ palette.white }}"

[colors.bright]
black = "{{ palette.bright_black }}"
red = "{{ palette.bright_red }}"
green = "{{ palette.bright_green }}"
yellow = "{{ palette.bright_yellow }}"
blue = "{{ palette.bright_blue }}"
magenta = "{{ palette.bright_magenta }}"
cyan = "{{ palette.bright_cyan }}"
white = "{{ palette.bright_white }}"

[colors.dim]
black = "{{ palette.dim_black }}"
red = "{{ palette.dim_red }}"
green = "{{ palette.dim_green }}"
yellow = "{{ palette.dim_yellow }}"
blue = "{{ palette.dim_blue }}"
magenta = "{{ palette.dim_magenta }}"
cyan = "{{ palette.dim_cyan }}"
white = "{{ palette.dim_white }}"
