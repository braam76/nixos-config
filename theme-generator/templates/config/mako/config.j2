# Vague palette: https://github.com/vague-theme/vague
background-color={{ roles.background }}
border-color={{ palette.iris }}
font=JetBrainsMono Nerd Font 12
on-button-left=invoke-default-action
progress-color=over {{ roles.surface }}
text-color={{ roles.foreground }}

[urgency=critical]
background-color={{ roles.background }}
border-color={{ roles.error }}
text-color={{ roles.foreground }}

[urgency=low]
background-color={{ roles.background }}
border-color={{ roles.muted }}
text-color={{ roles.foreground }}

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
