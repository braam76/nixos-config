# Vague palette: https://github.com/vague-theme/vague
[colors]
background={{ roles.background|rgba("ff") }}
border={{ roles.muted|rgba("ff") }}
counter={{ roles.bright|rgba("ff") }}
input={{ roles.foreground|rgba("ff") }}
match={{ roles.accent|rgba("ff") }}
placeholder={{ roles.muted|rgba("ff") }}
prompt={{ roles.foreground|rgba("ff") }}
selection={{ roles.surface|rgba("ff") }}
selection-match={{ roles.accent|rgba("ff") }}
selection-text={{ roles.bright|rgba("ff") }}
text={{ roles.foreground|rgba("ff") }}

[main]
font=Iosevka Nerd Font:size=14
minimal-lines=true
